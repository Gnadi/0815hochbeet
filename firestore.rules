rules_version = '2';

// Each account reads and writes only its own beds. Nothing else is stored in
// Firestore — the plant library ships with the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/beds/{bedId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.size() < 200
        && request.resource.data.rev is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
